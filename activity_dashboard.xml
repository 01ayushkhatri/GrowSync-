<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="GrowSync"
                android:textColor="#2457C5"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnProfileMenu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/profile_circle"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="S"
                android:textColor="#FFFFFF"
                android:textSize="21sp"
                android:textStyle="bold"
                android:contentDescription="Open profile menu" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Welcome, Student! 👋"
            android:textColor="#202A44"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Let's check your progress today."
            android:textColor="#667085"
            android:textSize="15sp" />

        <!-- Learning Journey banner -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#2457C5"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your Learning Journey"
                android:textColor="#FFFFFF"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Every small step takes you closer to your goals. Keep learning, keep growing!"
                android:textColor="#EAF0FF"
                android:textSize="15sp"
                android:lineSpacingExtra="4dp" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Your Activities"
            android:textColor="#202A44"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnMySubjects"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="My Subjects" />

        <Button
            android:id="@+id/btnMyAttendance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="My Attendance" />

        <Button
            android:id="@+id/btnMyAssignments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="My Assignments" />

        <Button
            android:id="@+id/btnMyProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="My Progress &amp; Marks" />

    </LinearLayout>
</ScrollView>
